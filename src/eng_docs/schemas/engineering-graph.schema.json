{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized engineering graph",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "source_revision",
    "source_graph",
    "object_count",
    "relation_count",
    "objects",
    "relations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "brainboxemb.engineering-graph"
    },
    "schema_version": {
      "const": 1
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_graph": {
      "type": "object",
      "required": [
        "kind",
        "project",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "sphinx-needs"
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "object_count": {
      "type": "integer",
      "minimum": 0
    },
    "relation_count": {
      "type": "integer",
      "minimum": 0
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "type_name",
          "title",
          "source",
          "content",
          "diagram_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "type_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "diagram_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "diagram_id",
                "node_id"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "diagram_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "node_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "type",
          "to",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
