{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagram.schema.json",
  "title": "Declarative engineering diagram",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagram"
  ],
  "properties": {
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 240
        },
        "description": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "structure",
            "sequence"
          ],
          "default": "structure"
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/box"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/participant"
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "layout"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "$ref": "#/$defs/rect"
        },
        "outline": {
          "$ref": "#/$defs/outline"
        },
        "label_offset": {
          "$ref": "#/$defs/nonNegativeOffset"
        },
        "note": {
          "type": "string"
        },
        "notation": {
          "type": "string",
          "enum": [
            "component",
            "packaging-component"
          ]
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "properties_width": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "layout"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string"
        },
        "notation": {
          "type": "string",
          "enum": [
            "component",
            "packaging-component",
            "class",
            "wireframe-panel",
            "wireframe-tabs",
            "wireframe-input",
            "wireframe-button",
            "wireframe-table",
            "wireframe-status"
          ]
        },
        "layout": {
          "$ref": "#/$defs/rect"
        },
        "note": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nodeItem"
          }
        }
      }
    },
    "nonNegativeOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "normalizedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points"
      ],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/normalizedPoint"
          }
        },
        "corner_radius": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side"
      ],
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "top",
            "right",
            "bottom",
            "left"
          ]
        },
        "position": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "default": "dependency"
        },
        "dashed": {
          "type": "boolean",
          "default": false
        },
        "from_anchor": {
          "$ref": "#/$defs/anchor"
        },
        "to_anchor": {
          "$ref": "#/$defs/anchor"
        },
        "route": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "nodeItem": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nodeItem"
              }
            },
            "object_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "label"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "call",
            "async",
            "return"
          ],
          "default": "call"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "diagram": {
            "properties": {
              "type": {
                "const": "sequence"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      },
      "then": {
        "required": [
          "participants",
          "messages"
        ]
      },
      "else": {
        "required": [
          "groups",
          "nodes",
          "edges"
        ]
      }
    }
  ]
}
