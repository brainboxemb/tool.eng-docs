{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-manifest.schema.json",
  "title": "Engineering documentation asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1}
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "lifecycle", "relationship", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "lifecycle": {
            "type": "string",
            "enum": ["build", "design-doc", "verification", "docs"]
          },
          "relationship": {
            "type": "string",
            "enum": ["generate-inline", "producer-source", "reference-existing", "reference-evidence"]
          },
          "path": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "bundle": {"type": "string", "minLength": 1},
          "display": {"type": "object"}
        }
      }
    }
  }
}
