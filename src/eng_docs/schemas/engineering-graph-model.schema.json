{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brainboxemb.example/schemas/engineering-graph-model.schema.json",
  "title": "Engineering graph model",
  "type": "object",
  "required": [
    "schema_version",
    "object_types",
    "relations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_object_type": {
      "type": "string",
      "minLength": 1
    },
    "object_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
